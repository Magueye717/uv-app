{
  "expo": {
    "name": "UV-APP",
    "slug": "UV-APP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uvapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F1B4C"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F1B4C"
        }
      ],
      "expo-web-browser",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner une carte étudiant trouvée pour prévenir son propriétaire."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "La caméra sert à photographier un objet trouvé ou perdu.",
          "photosPermission": "Tes photos servent à illustrer un objet trouvé ou perdu."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
